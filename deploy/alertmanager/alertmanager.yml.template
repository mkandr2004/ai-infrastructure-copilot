global:
  resolve_timeout: 5m

route:
  receiver: ai-copilot-api
  group_by:
    - alertname
    - severity
  group_wait: 15s
  group_interval: 1m
  repeat_interval: 4h

receivers:
  - name: ai-copilot-api
    webhook_configs:
      - url: http://app:8000/alerts/webhook
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: __ALERT_WEBHOOK_TOKEN__
